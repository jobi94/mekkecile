---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
}

const { title, description, path, heading } = Astro.props;
---

<BaseLayout title={title} description={description} path={path} includeOrgJsonLd={false}>
  <Header />
  <main id="hlavni-obsah" class="container-page py-14 sm:py-20">
    <h1 class="font-display text-3xl font-800 sm:text-4xl">{heading}</h1>
    <div class="prose-legal mt-8 max-w-3xl">
      <slot />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .prose-legal :global(h2) {
    margin-top: 2rem;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .prose-legal :global(p) {
    margin-top: 0.9rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .prose-legal :global(ul) {
    margin-top: 0.9rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--color-ink-soft);
  }
  .prose-legal :global(li) {
    margin-top: 0.4rem;
  }
  .prose-legal :global(a) {
    color: var(--color-brand-blue);
    text-decoration: underline;
  }
</style>
