---
import { courses } from '../data/courses';
import Icon from './Icon.astro';
---

<section id="skoleni" class="py-16 sm:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Programy</p>
      <h2 class="mt-3 font-display text-3xl font-800 sm:text-4xl">Školení a nácviky</h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        Programy skládáme podle doporučení Minimálního standardu bezpečnosti MŠMT. Rozklikněte
        kartu pro podrobný obsah — poptávku odešlete rovnou s předvyplněným programem.
      </p>
    </div>
  </div>

  <div
    class="carousel-track no-scrollbar mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-5 sm:px-[max(1.25rem,calc((100vw-72rem)/2+1.25rem))]"
    role="region"
    aria-label="Programy a nácviky — posuvný seznam"
    aria-roledescription="karusel"
    tabindex="0"
  >
    {courses.map((c) => (
      <article
        id={`program-${c.id}`}
        class="carousel-card group flex w-[85%] flex-none scroll-ml-5 snap-start flex-col rounded-card border border-border-subtle bg-white p-6 transition-colors duration-200 hover:border-ink hover:bg-ink sm:w-[340px]"
      >
        <div class="flex flex-1 flex-col">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-brand-yellow">
              <Icon name={c.icon as any} class="h-5 w-5" />
            </span>
            <span class="font-display text-xs font-800 uppercase tracking-wide text-muted transition-colors duration-200 group-hover:text-white/70">
              Program {c.letter}
            </span>
          </div>

          <h3 class="mt-4 text-lg font-bold leading-snug transition-colors duration-200 group-hover:text-white">{c.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted transition-colors duration-200 group-hover:text-white/80">{c.promise}</p>

          <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2 text-xs">
            <dt class="font-bold transition-colors duration-200 group-hover:text-white">Pro koho</dt>
            <dd class="text-muted transition-colors duration-200 group-hover:text-white/80">{c.audienceLabel}</dd>
            <dt class="font-bold transition-colors duration-200 group-hover:text-white">Délka</dt>
            <dd class="text-muted transition-colors duration-200 group-hover:text-white/80">{c.duration}</dd>
            <dt class="font-bold transition-colors duration-200 group-hover:text-white">Frekvence</dt>
            <dd class="text-muted transition-colors duration-200 group-hover:text-white/80">{c.frequency}</dd>
          </dl>

          <details class="mt-4 text-sm">
            <summary class="cursor-pointer font-semibold text-brand-blue transition-colors duration-200 group-hover:text-brand-yellow">
              Podrobný obsah
            </summary>
            <p class="mt-2 leading-relaxed text-muted transition-colors duration-200 group-hover:text-white/80">{c.detail}</p>
            <ul class="mt-3 flex flex-col gap-1.5">
              {c.takeaway.map((t) => (
                <li class="flex items-start gap-2 text-muted transition-colors duration-200 group-hover:text-white/80">
                  <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-brand-blue transition-colors duration-200 group-hover:text-brand-yellow" />
                  {t}
                </li>
              ))}
            </ul>
            {c.maxGroup && <p class="mt-3 text-xs font-semibold transition-colors duration-200 group-hover:text-white">{c.maxGroup}</p>}
          </details>
        </div>

        <a
          href="#poptavka"
          class="poptat-link btn btn-primary mt-6 transition-colors duration-200 group-hover:bg-brand-yellow group-hover:text-ink"
          data-program={c.id}
          data-program-name={c.name}
        >
          Poptat tento program
        </a>
      </article>
    ))}
  </div>

  <div class="container-page mt-6 flex justify-center gap-2" role="group" aria-label="Přejít na program">
    {courses.map((c) => (
      <a
        href={`#program-${c.id}`}
        class="carousel-dot h-2.5 w-2.5 rounded-full bg-border-subtle transition-colors"
        aria-label={`Přejít na program ${c.letter}: ${c.name}`}
        data-target={`program-${c.id}`}
      ></a>
    ))}
  </div>
</section>


<script src={`${import.meta.env.BASE_URL}js/carousel.js`} type="module" defer></script>
