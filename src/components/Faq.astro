---
import { faq } from '../data/faq';
import Icon from './Icon.astro';

const visibleCount = 6;
---

<section id="faq" class="bg-surface-alt py-16 sm:py-24">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Časté dotazy</p>
      <h2 class="mt-3 font-display text-3xl font-800 sm:text-4xl">Otázky, které nám kladou nejčastěji</h2>
    </div>

    <div class="expand-wrap mx-auto mt-10 max-w-3xl">
      <div class="flex flex-col gap-3">
        {faq.map((item, i) => (
          <details class={`group rounded-card bg-white p-5 open:shadow-sm ${i >= visibleCount ? 'expand-extra' : ''}`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <Icon name="chevron-down" class="h-5 w-5 flex-none transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted">{item.answer}</p>
          </details>
        ))}
      </div>

      {faq.length > visibleCount && (
        <>
          <input type="checkbox" id="faq-toggle" class="expand-toggle sr-only" />
          <label
            for="faq-toggle"
            class="mt-5 inline-flex cursor-pointer items-center gap-2 text-sm font-bold text-brand-blue underline"
          >
            <span class="show-more-text">Zobrazit všechny otázky ({faq.length})</span>
            <span class="show-less-text">Zobrazit méně</span>
          </label>
        </>
      )}
    </div>
  </div>
</section>
