---
import { site } from '../site.config';
---

<section id="msmt" class="bg-brand-blue py-16 text-white sm:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow text-brand-yellow">Soulad s MŠMT</p>
      <h2 class="mt-3 font-display text-3xl font-800 sm:text-4xl">
        Splňujeme požadavky MŠMT na dodavatele
      </h2>
      <p class="mt-4 text-base leading-relaxed text-white/85">
        Jihomoravský portál pro školy varuje, že někteří dodavatelé uvádějí spolupráci
        s důvěryhodnými institucemi, aniž by ji doložili. Doporučujeme školám tyto doklady
        u každého dodavatele ověřit — rádi je předložíme.
      </p>
    </div>

    {site.accreditationDvpp && !site.accreditationDvpp.startsWith('{{') && (
      <p class="mt-4 text-sm font-semibold text-white">
        Akreditace DVPP MŠMT: {site.accreditationDvpp}
      </p>
    )}

    <a
      href="https://edu.gov.cz/pro-vedeni-skoly/bezpecnost-na-skolach/"
      rel="noopener"
      target="_blank"
      class="mt-8 inline-block text-sm font-bold text-brand-yellow underline"
    >
      Minimální standard bezpečnosti MŠMT (edu.gov.cz) →
    </a>
  </div>
</section>
