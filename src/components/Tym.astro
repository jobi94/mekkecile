---
import { lecturers } from '../data/lektori';
---

{lecturers.length > 0 && (
  <section id="tym" class="py-16 sm:py-24">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Lektoři</p>
        <h2 class="mt-3 font-display text-3xl font-800 sm:text-4xl">Kdo vás bude školit</h2>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {lecturers.map((l) => (
          <div class="rounded-card border border-border-subtle p-6">
            {l.photo && (
              <img src={l.photo} alt={l.name} width="96" height="96" loading="lazy" class="h-24 w-24 rounded-full object-cover" />
            )}
            <h3 class="mt-4 text-lg font-bold">{l.name}</h3>
            <p class="text-sm font-semibold text-brand-blue">{l.role}</p>
            <ul class="mt-3 flex flex-col gap-1 text-sm text-muted">
              {l.qualifications.map((q) => <li>{q}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
